# ─────────────────────────────────────────────────────────────────────
# Plausible Analytics — self-host env (docker-compose.plausible.yml)
# ─────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env.plausible` y rellena los valores marcados.
# NUNCA commitees `.env.plausible` (ya está en .gitignore).
#
#   cp .env.plausible.example .env.plausible
#
# ── App (Plausible / Phoenix) ────────────────────────────────────────

# URL pública del panel. Debe ser https y coincidir con la route del Tunnel.
BASE_URL=https://analytics.vara-alta.lat

# Secreto de sesión Phoenix. Generar UNA vez con:
#   openssl rand -base64 48
# (en Windows sin openssl: `python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(48)).decode())"`)
SECRET_KEY_BASE=__CHANGE_ME__generate_with_openssl_rand_base64_48__

# invite_only = nadie se registra solo; el admin invita. NO usar 'false'
# en producción (abriría registro público).
DISABLE_REGISTRATION=invite_only

# ── Postgres (metadata: sitios, usuarios) ────────────────────────────

POSTGRES_USER=plausible
POSTGRES_PASSWORD=__CHANGE_ME__strong_random_password__
POSTGRES_DB=plausible_db

# Connection string que usa la app. Debe casar con las 3 vars de arriba.
DATABASE_URL=postgres://plausible:__CHANGE_ME__strong_random_password__@plausible_db:5432/plausible_db

# ── Clickhouse (event store: pageviews + custom events) ──────────────

CLICKHOUSE_DATABASE_URL=http://plausible_events_db:8123/plausible_events_db

# ─────────────────────────────────────────────────────────────────────
# Stats API (consumido por src/common/plausible_client.py)
# ─────────────────────────────────────────────────────────────────────
# Se generan DESPUÉS del primer arranque, desde el panel:
#   Site Settings → API Keys → New API Key
# Guárdalos en el .env del pipeline (NO aquí; este archivo es solo del stack).
#
#   PLAUSIBLE_BASE_URL=https://analytics.vara-alta.lat
#   PLAUSIBLE_API_KEY=__from_panel__
#   PLAUSIBLE_SITE_ID=youlikeit.vara-alta.lat
