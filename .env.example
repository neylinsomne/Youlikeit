# Navegacion
HEADLESS=true
TIMEOUT_MS=20000

# Directorios
OUTPUT_DIR=outputs
DATA_DIR=data

# Ejemplo API (opcional para ejercicios futuros)
YOUTUBE_API_KEY=
OPENAI_API_KEY=
FISH_API_KEY=
PEXELS_API_KEY=

# === Pipeline de Shorts (todas gratis) ===

# TMDB - https://www.themoviedb.org/settings/api (gratis, sin limite real)
# Opcional: sin esta key, ex04 usa lista hardcoded de peliculas iconicas
TMDB_API_KEY=

# OpenSubtitles - https://www.opensubtitles.com/consumers (gratis, 20 descargas/dia)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# SubDL (alternativa) - https://subdl.com/panel/api (gratis, 20 descargas/dia)
SUBDL_API_KEY=

# === Clasificacion con LLM - ex10 (elegir UNA, ambas gratis) ===

# Groq - https://console.groq.com/keys (gratis, 30 req/min)
GROQ_API_KEY=

# Gemini - https://aistudio.google.com/apikey (gratis, 15 req/min)
GEMINI_API_KEY=

# Si no pones ninguna, ex10 usa clasificador heuristico (sin internet)
