# ============================================================
# YouTube Shorts Pipeline - Variables de Entorno
# ============================================================
# Copia este archivo a .env y llena los valores.
# Ninguna variable es obligatoria - el pipeline degrada
# gracefully sin cada key (usa fallbacks o heurísticos).
# ============================================================

# ─── General ───────────────────────────────────────────────
HEADLESS=true                   # Playwright headless mode
TIMEOUT_MS=20000                # Timeout para scraping
OUTPUT_DIR=outputs              # Directorio de salidas
DATA_DIR=data                   # Directorio de datos/BD

# ─── TMDB (ex04: descubrir películas) ──────────────────────
# https://www.themoviedb.org/settings/api
# Gratis, sin límite práctico. Sin key: usa lista hardcoded.
TMDB_API_KEY=

# ─── OMDb (ex04: ratings IMDb/RT/Metacritic) ────────────────
# https://www.omdbapi.com/apikey.aspx
# Gratis: 1,000 req/día. Enriquece películas con ratings
# de IMDb, Rotten Tomatoes y Metacritic (TMDB no los tiene).
# Sin key: ex04 funciona normal, solo sin ratings externos.
OMDB_API_KEY=

# ─── Trakt (ex04: trending real-time) ───────────────────────
# https://trakt.tv/oauth/applications → crear app → Client ID
# Gratis: 1,000 req/5min. Muestra qué películas está viendo
# la gente AHORA (vs TMDB trending que es por page views).
# Sin key: ex04 funciona normal, solo sin trending de Trakt.
TRAKT_CLIENT_ID=

# ─── Subtítulos (ex05: descargar .srt) ────────────────────
# Cascada: OpenSubtitles → SubDL → Whisper (local)
# Si no pones ninguna key, Whisper genera subtítulos desde
# el audio del trailer (requiere GPU, pip install openai-whisper).

# OpenSubtitles - https://www.opensubtitles.com/consumers
# Gratis: 20 descargas/día, 40 requests/10s
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# SubDL (alternativa) - https://subdl.com/panel/api
# Gratis: 20 descargas/día
SUBDL_API_KEY=

# Whisper modelo (base, small, medium, large)
# base = rápido, bueno para inglés. medium = mejor calidad.
# No necesita API key — corre 100% local con GPU.
WHISPER_MODEL=base

# ─── LLM para clasificación (ex10, ex18, ex31) ────────────
# Cascada: Gemini → Groq → airllm → heurístico
# Gemini primero porque tiene 1M tokens de contexto (cabe
# todo el system prompt con insights del proyecto).
# Si no pones ninguna, usa clasificador heurístico.

# Gemini - https://aistudio.google.com/apikey
# Gratis: 10 req/min, 250 req/día, 1M contexto
GEMINI_API_KEY=

# Groq - https://console.groq.com/keys
# Gratis: 30 req/min, 128K contexto
GROQ_API_KEY=

# ─── YouTube Data API v3 (ex12, ex19) ─────────────────────
# https://console.cloud.google.com/apis/credentials
# Gratis: 10,000 unidades/día (suficiente para ~100 queries)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ─── YouTube OAuth (ex34, ex24, ex26) ─────────────────────
# Para: subir videos (ex12), YouTube Analytics API
# (retención segundo a segundo, demographics).
#
# Setup en Google Cloud Console:
#   1. APIs → habilitar estas 3:
#      - YouTube Data API v3
#      - YouTube Analytics API
#      - YouTube Reporting API
#   2. Credenciales → OAuth 2.0 Client ID → Aplicación de escritorio
#   3. Descargar JSON → renombrar a client_secrets.json
#   4. Pantalla de consentimiento → Externo → agregar scopes:
#      - youtube.readonly
#      - youtube.upload
#      - yt-analytics.readonly
#   5. Usuarios de prueba → agregar tu Gmail
#   6. Ejecutar: python src/main.py ex34
GOOGLE_CLIENT_SECRETS=client_secrets.json

# ─── Fish Audio S1-Mini TTS (ex18: narración) ─────────────
# Motor de TTS que corre local via Docker.
# Fish = solo TTS (texto → voz). El LLM genera el guión.
#
# Flujo:
#   [LLM genera texto] → [Fish Speech convierte a .wav]
#   Sin LLM: templates heurísticos → Fish Speech
#   Sin Fish: se generan .wav silenciosos (placeholder)
FISH_SPEECH_URL=http://localhost:8080
VOICE_REF_PATH=

# ─── Pixabay (ex18: música de fondo royalty-free) ──────────
# https://pixabay.com/api/docs/
# Gratis: 200 req/hora. Busca música por emoción/mood.
# Sin key: el narration manifest no incluye sugerencia de
# música, la eliges manualmente en la plataforma.
PIXABAY_API_KEY=

# ─── TikTok (ex19: analytics de competencia) ──────────────
# Solo username, no requiere API key (scraping con Playwright)
TIKTOK_USERNAME=

# ─── airllm - LLM local via GPU (fallback offline) ────────
# Solo se usa si Gemini y Groq no están disponibles.
# Carga modelos capa por capa en GPU (lento pero offline).
AIRLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
AIRLLM_COMPRESSION=4bit
AIRLLM_MAX_SEQ_LEN=512
HF_TOKEN=

# ─── qBittorrent (descarga de películas, opcional) ────────
# Solo si usas el contenedor de qBittorrent
QBIT_URL=http://localhost:8090
QBIT_USER=admin
QBIT_PASS=

# ─── APIs reservadas (no usadas activamente) ──────────────
OPENAI_API_KEY=
FISH_API_KEY=
PEXELS_API_KEY=

# ─── Puertos de servidores ─────────────────────────────────
# ex28 (dashboard):  8080
# ex29 (API REST):   8001
# ex30 (frontend):   8002
# fish-speech:       8080 (descomentar en docker-compose.yml)
# qbittorrent:       8090
