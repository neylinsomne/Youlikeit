<?xml version="1.0"?>
<!-- Disable per-query logging at the user/profile level (Plausible CE default).
     Keeps the events DB lean on a single-host self-hosted deployment. -->
<clickhouse>
    <profiles>
        <default>
            <log_queries>0</log_queries>
            <log_query_threads>0</log_query_threads>
        </default>
    </profiles>
</clickhouse>
